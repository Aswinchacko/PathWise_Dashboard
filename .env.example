# Copy to `.env` for local dashboard dev.
# Full stack: `docker compose up` (nginx on :80), then `npm run dev` — leave VITE_PUBLIC_API_URL unset to use Vite proxy.

# Vite dev proxy (vite.config.js — not exposed to the browser):
# Auth Express defaults to http://127.0.0.1:5000; other /api/* defaults to http://127.0.0.1:80 (nginx).
# If you route everything through nginx only, set both to http://127.0.0.1:80
# DEV_PROXY_AUTH_TARGET=http://127.0.0.1:5000
# DEV_PROXY_GATEWAY_TARGET=http://127.0.0.1:80

# Optional: explicit API origin (production build or non-standard port)
# VITE_PUBLIC_API_URL=https://api.example.com

# Optional overrides when services are not behind the same nginx origin:
# VITE_PROJECT_RECOMMENDATION_URL=
# VITE_MICROLEARNING_API_URL=
# VITE_MENTOR_API_URL=
# VITE_RESOURCES_PUBLIC_URL=
