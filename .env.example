# Copy to `.env` for local dashboard dev.
# Full stack: `docker compose up` (nginx on :80), then `npm run dev` — leave VITE_PUBLIC_API_URL unset to use Vite proxy.

# Vite dev proxy (vite.config.js — not exposed to the browser):
# Auth Express defaults to http://127.0.0.1:5000; other /api/* defaults to http://127.0.0.1:80 (nginx).
# If you route everything through nginx only, set both to http://127.0.0.1:80
# DEV_PROXY_AUTH_TARGET=http://127.0.0.1:5000
# DEV_PROXY_CHATBOT_TARGET=http://127.0.0.1:8004
# DEV_PROXY_ROADMAP_TARGET=http://127.0.0.1:8000
# DEV_PROXY_GATEWAY_TARGET=http://127.0.0.1:80

# Optional: explicit API origin (production build or roadmap on another host/port).
# Include scheme + host + port (no trailing slash). Used by roadmap + nginx-routed APIs via apiUrl().
# VITE_PUBLIC_API_URL=https://api.example.com
# VITE_PUBLIC_API_URL=http://YOUR_PUBLIC_IP:8000

# Optional: Express auth_back origin when it is NOT the same host as VITE_PUBLIC_API_URL
# (e.g. Vercel SPA → EC2 :5000 for login). Same scheme/host/port rules, no trailing slash.
# VITE_EXPRESS_PUBLIC_ORIGIN=http://YOUR_PUBLIC_IP:5000

# Optional overrides when services are not behind the same nginx origin:
# VITE_PROJECT_RECOMMENDATION_URL=
# Micro-learning defaults to port 8008 — resume-parser uses 8005 (matches docker-compose).
# VITE_MICROLEARNING_API_URL=http://localhost:8008/api/v1/microlearning
# VITE_MENTOR_API_URL=
# VITE_RESOURCES_PUBLIC_URL=
