VITE_API_URL=http://localhost:8000

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# GitHub OAuth
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# LinkedIn OAuth
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here 